CLIQ_GATEWAY_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIQ_ORGANIZATION_ID=YOUR_ZOHO_ORGANIZATION_ID
DATABASE_URL=postgresql://YOUR_PRIVATE_CONNECTION_STRING
# Optional per-app overrides if your apps use different databases:
# STOCK_DATABASE_URL=
# BOE_DATABASE_URL=
# RESEARCH_DATABASE_URL=
# AWC_DATABASE_URL=
# Each version is the account's current session_version, not always 1.
CLIQ_USERS_JSON={"YOUR_CLIQ_USER_ID":{"stock":{"username":"YOUR_APP_USERNAME","version":1},"boe":{"username":"YOUR_APP_USERNAME","version":1},"research":{"username":"YOUR_APP_USERNAME","version":1},"awc":{"username":"YOUR_APP_USERNAME","version":1}}}
# Conversational AI: selected authorized records go to Gemini only with opt-in.
# AI_DATA_SHARING_ENABLED=true
# Explicit commands need no AI key.
# GEMINI_API_KEY=
# GEMINI_MODEL=YOUR_ENABLED_MODEL_ID
